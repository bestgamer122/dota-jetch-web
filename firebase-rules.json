{
  "rules": {
    "users": {
      "$uid": {
        ".read": "$uid === auth.uid",
        ".write": "$uid === auth.uid"
      }
    },
    "nicknames": {
      ".read": true,
      "$nick": {
        ".write": "auth != null && (!data.exists() || data.val() === auth.uid)",
        ".validate": "newData.val() === auth.uid || !newData.exists()"
      }
    },
    "publicProfiles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && $uid === auth.uid"
      }
    },
    "leaderboards": {
      "$game": {
        ".read": "auth != null",
        ".indexOn": ["score"],
        "$uid": {
          ".write": "auth != null && $uid === auth.uid"
        }
      }
    }
  }
}
